<h1>👁️ <%= @task.title %></h1>

<div class="container">
  <p style="text-align:center; font-size:1rem; color:var(--text-muted); margin-bottom:20px">
    Статус: <%= @task.completed? ? '✅ Завершено' : '⬜ В процессе' %>
  </p>

  <p style="text-align:center; margin-bottom:8px">
    <span class="task-category-badge"><%= t("categories.#{@task.category}") %></span>
  </p>

  <% if @task.due_date.present? %>
    <p style="text-align:center; margin-bottom:24px">
      <small style="color:var(--text-muted)">📅 Дата выполнения: <%= @task.due_date.strftime("%d.%m.%Y") %></small>
    </p>
  <% end %>

  <p style="text-align:center; margin-bottom:24px">
    <small style="color:var(--text-muted)">Создано: <%= l(@task.created_at, format: :short) %></small>
  </p>

  <div class="form-actions" style="justify-content:center">
    <%= button_to @task.completed? ? '↩️ Отменить' : '✅ Завершить',
        toggle_task_path(@task), method: :post, class: 'btn btn-primary' %>
  </div>

  <div class="form-actions" style="justify-content:center; margin-top:12px">
    <%= link_to '✏️ Редактировать', edit_task_path(@task), class: 'btn btn-ghost' %>
    <%= button_to '🗑️ Удалить', @task, method: :delete,
        data: { confirm: 'Удалить задачу?' }, class: 'btn btn-danger' %>
  </div>

  <%= link_to '← Назад к списку', tasks_path, class: 'back-link', style: 'display:block; text-align:center' %>
</div>